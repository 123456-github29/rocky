{
  "name": "rocky-triage",
  "version": "0.1.0",
  "description": "Reads your error logs, works out what is actually wrong, and writes each problem up as a work item with the evidence behind it \u2014 then asks you before a coding agent touches anything.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/123456-github29/rocky.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "rocky": "./dist/rocky.js",
    "rocky-eval": "./dist/rocky-eval.js",
    "rocky-source": "./dist/rocky-source.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "npm run build && node dist/rocky-eval.js eval/example-pairs.json",
    "prepare": "npm run build"
  },
  "keywords": [
    "triage",
    "error-logs",
    "sentry",
    "glitchtip",
    "bug-reports",
    "issues",
    "llm",
    "agents",
    "sre",
    "eval"
  ],
  "dependencies": {
    "openai": "^7.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
